rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ========================================================================
    // HELPER FUNCTIONS
    // ========================================================================
    
    function getUserRole() {
      return request.auth.token.role;
    }
    
    function isAdmin() {
      return getUserRole() == 'admin';
    }
    
    function isModerator() {
      return getUserRole() == 'moderator';
    }
    
    function isContributor() {
      return getUserRole() == 'contributor';
    }
    
    function canCreate() {
      return isAdmin() || isModerator() || isContributor();
    }
    
    function canEditAny() {
      return isAdmin() || isModerator();
    }
    
    function isProductIdeaOwner(ownerId) {
      return request.auth.uid == ownerId;
    }

    function isProductIdeaNoteAuthor(authorId) {
      return request.auth.uid == authorId;
    }

    function isSignedOn() {
      return request.auth != null;
    }

    function authIdMatchesUserId(userId) {
      return request.auth.uid == userId;
    }
    
    // ========================================================================
    // USER PROFILES
    // ========================================================================
    match /users/{userId} {
      function isValidUserProfile() {
        let data = request.resource.data;
        return data.firstName is string
          && data.firstName.size() > 0
          && data.firstName.size() <= 50
          && data.lastNameInitial is string
          && data.lastNameInitial.size() <= 1
          && data.role in ['viewer', 'contributor', 'moderator', 'admin'];
      }
      
      // Anyone authenticated can read any profile
      allow read: if isSignedOn();
      
      // Users can create their own profile (once) with viewer role
      allow create: if isSignedOn()
        && authIdMatchesUserId(userId)
        && request.resource.data.role == 'viewer'
        && isValidUserProfile();
      
      // Only admins can update user documents (including role changes)
      allow update: if isAdmin()
        && isValidUserProfile();
      
      // Nobody can delete user profiles
      allow delete: if false;
    }
    
    // ========================================================================
    // PRODUCT IDEAS
    // ========================================================================
    match /productIdeas/{ideaId} {
      function isValidProductIdea() {
        let data = request.resource.data;
        let hasValidTags = !('tags' in data) 
          || (data.tags is list && data.tags.size() <= 10);
        let hasValidPriority = !('priority' in data) 
          || data.priority in ['now', 'next', 'later'];
        
        return data.title is string
          && data.title.size() > 0
          && data.title.size() <= 100
          && data.summary is string
          && data.summary.size() > 0
          && data.summary.size() <= 1000
          && data.status in ['draft', 'active', 'paused', 'shipped']
          && data.ownerId is string
          && hasValidTags
          && hasValidPriority;
      }
      
      function isValidArchiveUpdate() {
        let data = request.resource.data;
        let prev = resource.data;
        
        // Only archivedAt and updatedAt can change in archive/unarchive ops
        return data.diff(prev).affectedKeys().hasOnly(['archivedAt', 'updatedAt']);
      }
      
      // Anyone authenticated can read (including archived)
      allow read: if isSignedOn();
      
      // Contributors+ can create (must own it)
      allow create: if canCreate()
        && request.resource.data.ownerId == request.auth.uid
        && isValidProductIdea();
      
      // Admins/mods can edit anything, contributors can edit their own
      // ownerId cannot be changed
      // createdAt cannot be changed
      allow update: if (canEditAny() || isProductIdeaOwner(resource.data.ownerId))
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && isValidProductIdea();
      
      // Only admins can hard delete (archiving is preferred)
      allow delete: if isAdmin();
      
      // ======================================================================
      // PRODUCT IDEA NOTES (subcollection)
      // ======================================================================
      match /notes/{noteId} {
        function isValidNote() {
          let data = request.resource.data;
          return data.body is string
            && data.body.size() > 0
            && data.body.size() <= 2000
            && data.authorId is string
            && data.authorDisplayName is string
            && data.authorDisplayName.size() > 0;
        }
        
        // Anyone authenticated can read notes (including archived)
        allow read: if isSignedOn();
        
        // Contributors+ can create notes (must be author)
        allow create: if canCreate()
          && request.resource.data.authorId == request.auth.uid
          && isValidNote();
        
        // Admins/mods can edit any note, authors can edit their own
        // authorId cannot be changed
        // createdAt cannot be changed
        allow update: if (canEditAny() || isProductIdeaNoteAuthor(resource.data.authorId))
          && request.resource.data.authorId == resource.data.authorId
          && request.resource.data.createdAt == resource.data.createdAt
          && isValidNote();
        
        // Only admins can hard delete (archiving is preferred)
        allow delete: if isAdmin();
      }
    }
  }
}